# ═══════════════════════════════════════════════════════════════
# SG-ERM 环境变量配置示例
#
# 使用方法：
#   cp .env.example .env
#   编辑 .env 文件，填入实际值
#
# 生成密钥：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ═══════════════════════════════════════════════════════════════

# ─── 1. 安全（必填） ──────────────────────────────────────────
# JWT 签名密钥，必须 ≥ 32 字符，建议 64 字符
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SG_ERM_SECRET_KEY=

# ─── 2. 网络 ──────────────────────────────────────────────────
SG_ERM_LISTEN_HOST=0.0.0.0
SG_ERM_LISTEN_PORT=18070

# ─── 3. 数据目录 ──────────────────────────────────────────────
# 容器内默认 /data，本地开发可用 ./data
SG_ERM_DATA_DIR=/data

# ─── 4. 数据库 ────────────────────────────────────────────────
SG_ERM_DB_FILENAME=sg-erm.db
# WAL 模式提升并发读性能
SG_ERM_DB_ENABLE_WAL=true
# 外键约束
SG_ERM_DB_ENABLE_FOREIGN_KEYS=true
# 同步模式：FULL / NORMAL / OFF
SG_ERM_DB_SYNCHRONOUS=NORMAL
# SQLITE_BUSY 等待毫秒
SG_ERM_DB_BUSY_TIMEOUT_MS=5000

# ─── 5. 上游仓库 ──────────────────────────────────────────────
SG_ERM_UPSTREAM_REPO_URL=https://extensions.stackgres.io/postgres/repository
SG_ERM_INDEX_PATH=v2/index.json

# ─── 6. 同步引擎 ──────────────────────────────────────────────
SG_ERM_SYNC_CONCURRENCY=8
SG_ERM_SYNC_DOWNLOAD_TIMEOUT=120
SG_ERM_SYNC_MAX_RETRIES=3

# ─── 7. 代理模式 ──────────────────────────────────────────────
# hybrid: 预同步白名单 + 代理兜底（推荐）
# strict: 仅返回本地已缓存包，未命中返回 404
# proxy_only: 不预同步，所有请求按需代理
SG_ERM_PROXY_MODE=hybrid

# ─── 8. 缓存淘汰 ──────────────────────────────────────────────
SG_ERM_CACHE_MAX_DISK_USAGE=80
SG_ERM_CACHE_TARGET_DISK_USAGE=70
SG_ERM_CACHE_TTL_DAYS=7
SG_ERM_CACHE_KEEP_VERSIONS=3

# ─── 9. JWT ────────────────────────────────────────────────────
SG_ERM_JWT_ALGORITHM=HS256
SG_ERM_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SG_ERM_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── 10. API Token ────────────────────────────────────────────
SG_ERM_API_TOKEN_PREFIX=sgerm_
SG_ERM_TOKEN_PREFIX_LEN=8
SG_ERM_API_TOKEN_RANDOM_BYTES=32

# ─── 11. 默认管理员 ──────────────────────────────────────────
# 首次启动创建，之后请通过 Web UI 修改密码
SG_ERM_DEFAULT_ADMIN_USERNAME=admin
SG_ERM_DEFAULT_ADMIN_PASSWORD=admin
SG_ERM_DEFAULT_ADMIN_EMAIL=admin@sg-erm.local

# ─── 12. 加密服务 ─────────────────────────────────────────────
SG_ERM_RSA_KEY_SIZE=2048
SG_ERM_PBKDF2_ITERATIONS=100000
SG_ERM_FILE_HASH_CHUNK_SIZE=65536

# ─── 13. 日志 ─────────────────────────────────────────────────
SG_ERM_CONSOLE_LOG_LEVEL=INFO
SG_ERM_FILE_LOG_LEVEL=DEBUG
SG_ERM_APP_LOG_MAX_BYTES=10485760
SG_ERM_APP_LOG_BACKUP_COUNT=5
SG_ERM_TASK_LOG_MAX_BYTES=10485760
SG_ERM_TASK_LOG_BACKUP_COUNT=10

# ─── 14. 调度 ─────────────────────────────────────────────────
SG_ERM_SCHEDULER_ENABLED=true

# ─── 15. 健康检查 ─────────────────────────────────────────────
SG_ERM_HEALTH_CHECK_INTERVAL=60
SG_ERM_HEALTH_CHECK_TIMEOUT=10
SG_ERM_HEALTH_DEGRADED_LATENCY_SEC=5
SG_ERM_HEALTH_CONSECUTIVE_FAILURE_THRESHOLD=3

# ─── 16. 命名默认值 ───────────────────────────────────────────
SG_ERM_DEFAULT_ARCH=x86_64
SG_ERM_DEFAULT_OS=linux
SG_ERM_DEFAULT_PUBLISHER=com.ongres

# ─── 17. IO ───────────────────────────────────────────────────
SG_ERM_IO_CHUNK_SIZE=8192
SG_ERM_TEMP_FILE_SUFFIX=.tmp

# ─── 18. HTTP 缓存头 ──────────────────────────────────────────
SG_ERM_HTTP_INDEX_CACHE_MAX_AGE=300
SG_ERM_HTTP_PACKAGE_CACHE_MAX_AGE=86400
